# Copy this file to .env and fill in your own values

# Mongo connection string — local mongod, or an Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/tokri

# Port the API listens on
PORT=5000

# Secret used to sign JWTs — change this to something long and random
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Origin of your React dev server, for CORS
CLIENT_URL=http://localhost:5173
